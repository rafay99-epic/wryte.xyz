{
  "name": "wryte",
  "version": "1.6.6",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter @wryte/web",
    "dev:convex": "turbo run dev --filter @wryte/backend",
    "dev:desktop": "turbo run dev --filter @wryte/desktop",
    "build": "turbo run build",
    "build:deploy": "bun run --filter @wryte/backend deploy",
    "start": "bun run --filter @wryte/web start",
    "lint": "biome check",
    "format": "biome format --write",
    "link-env": "ln -sfn ../../.env.local apps/web/.env.local && ln -sfn ../../.env.local packages/backend/.env.local",
    "type": "turbo run type",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @wryte/web test:e2e",
    "changelog:new": "bun run --filter @wryte/web changelog:new",
    "desktop:pack": "bun run --filter @wryte/desktop pack",
    "desktop:dist": "bun run --filter @wryte/desktop dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "electron",
    "electron-builder",
    "esbuild"
  ],
  "overrides": {
    "effect": "^3.21.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.0"
  },
  "patchedDependencies": {
    "@convex-dev/persistent-text-streaming@0.3.3": "patches/@convex-dev%2Fpersistent-text-streaming@0.3.3.patch"
  }
}
