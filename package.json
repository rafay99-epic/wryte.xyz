{
  "name": "wryte",
  "version": "1.6.6",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter @wryte/web",
    "dev:convex": "turbo run dev --filter @wryte/backend",
    "dev:desktop": "turbo run dev --filter @wryte/desktop",
    "build": "turbo run build",
    "build:deploy": "bun run --filter @wryte/backend deploy",
    "start": "bun run --filter @wryte/web start",
    "lint": "biome check",
    "format": "biome format --write",
    "link-env": "ln -sfn ../../.env.local apps/web/.env.local && ln -sfn ../../.env.local packages/backend/.env.local",
    "type": "turbo run type",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @wryte/web test:e2e",
    "changelog:new": "bun run --filter @wryte/web changelog:new",
    "desktop:pack": "bun run --filter @wryte/desktop pack",
    "desktop:dist": "bun run --filter @wryte/desktop dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "electron",
    "electron-builder",
    "esbuild"
  ],
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "fast-uri": "3.1.5",
    "sharp": "^0.35.0",
    "dompurify": "^3.4.13",
    "postcss": "^8.5.23",
    "ip-address": "^10.3.1",
    "effect": "^3.21.2",
    "ws": "^8.21.0",
    "js-cookie": "^3.0.7",
    "qs": "^6.15.2",
    "hono": "^4.12.34",
    "protobufjs": "^7.6.5",
    "body-parser": "^2.3.0",
    "@babel/core": "^7.29.7",
    "nanoid": "^3.3.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tar": "^7.5.22",
    "shell-quote": "^1.10.0",
    "app-builder-lib": "^26.15.3",
    "builder-util-runtime": "^9.7.0"
  },
  "patchedDependencies": {
    "@convex-dev/persistent-text-streaming@0.3.2": "patches/@convex-dev%2Fpersistent-text-streaming@0.3.2.patch"
  }
}
