{
  "name": "wrypte.xyz",
  "version": "0.29.0",
  "private": true,
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n NEXT,CONVEX -c blue,green \"next dev\" \"convex dev\"",
    "dev:local": "concurrently -n NEXT,CONVEX -c blue,green \"next dev\" \"convex dev \"",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "dev:convex:local": "convex dev --local",
    "build": "bunx convex deploy --cmd 'bun run stamp-version && next build'",
    "build:local": "next build",
    "stamp-version": "bun scripts/stamp-version.ts",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "type": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "changelog:new": "bun scripts/changelog-new.ts",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@base-ui/react": "^1.6.0",
    "@clerk/backend": "^3.10.0",
    "@clerk/nextjs": "^7.5.12",
    "@convex-dev/persistent-text-streaming": "^0.3.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.5",
    "@convex-dev/workflow": "^0.4.4",
    "@convex-dev/workpool": "^0.4.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.10.0",
    "@mdx-js/mdx": "^3.1.1",
    "@octokit/rest": "^22.0.1",
    "@pilio/gemini-watermark-remover": "^1.0.28",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "@workos-inc/node": "^10.7.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "convex": "^1.42.1",
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.0",
    "json5": "^2.2.3",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^6.45.0",
    "react": "19.2.7",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "smol-toml": "^1.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "xyz.wryte.desktop",
    "productName": "Wryte",
    "files": [
      "electron/**",
      "public/wryte-icon.png"
    ],
    "npmRebuild": false,
    "afterPack": "electron/afterpack-sign.cjs",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}.dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "rafay99-epic",
      "repo": "wryte.xyz",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@clerk/testing": "^2.2.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "electron",
    "electron-builder",
    "esbuild"
  ],
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "^8.5.14",
    "ip-address": "^10.2.0",
    "fast-uri": "^3.1.2",
    "effect": "^3.21.2",
    "ws": "^8.21.0",
    "brace-expansion": "^5.0.6",
    "js-cookie": "^3.0.7",
    "qs": "^6.15.2",
    "hono": "^4.12.25",
    "protobufjs": "^7.6.4",
    "@babel/core": "^7.29.7",
    "js-yaml": "^3.15.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tar": "^7.5.7"
  },
  "patchedDependencies": {
    "@convex-dev/persistent-text-streaming@0.3.2": "patches/@convex-dev%2Fpersistent-text-streaming@0.3.2.patch"
  }
}
