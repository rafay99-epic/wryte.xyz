{
  "name": "@wryte/backend",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "exports": {
    "./_generated/api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./_generated/server": {
      "types": "./convex/_generated/server.d.ts",
      "default": "./convex/_generated/server.js"
    },
    "./_generated/dataModel": "./convex/_generated/dataModel.d.ts",
    "./*": "./convex/*.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "dev:local": "convex dev --local",
    "deploy": "convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd 'cd ../../apps/web && bun run build'",
    "type": "tsc --noEmit -p convex/tsconfig.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@clerk/backend": "^3.17.1",
    "@convex-dev/persistent-text-streaming": "^0.3.3",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.8",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.11",
    "@google/genai": "^2.21.0",
    "@octokit/rest": "^22.0.1",
    "@workos-inc/node": "^10.13.0",
    "aws4fetch": "^1.0.20",
    "cloudinary": "^2.11.0",
    "convex": "^1.45.0",
    "convex-mcp-gateway": "0.5.0",
    "openai": "^6.49.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.8.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^7.0.2"
  }
}
