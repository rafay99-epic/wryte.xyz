{
  "name": "@wryte/desktop",
  "version": "1.6.4",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "WRYTE_FLAVOR=dev electron main.cjs",
    "dev": "bun run --parallel dev:vite dev:electron",
    "build:renderer": "vite build",
    "build": "bun run build:renderer",
    "type": "tsc --noEmit -p tsconfig.renderer.json",
    "pack": "bun run build:renderer && electron-builder --dir",
    "dist": "bun run build:renderer && electron-builder",
    "dev:pack": "WRYTE_FLAVOR=dev electron-builder --dir",
    "dev:dist": "WRYTE_FLAVOR=dev electron-builder"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.56.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/poppins": "^5.2.8",
    "@tanstack/react-query": "^5.101.2",
    "@wryte/backend": "workspace:*",
    "@wryte/logic": "workspace:*",
    "@wryte/ui": "workspace:*",
    "convex": "^1.42.3",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.0"
  }
}
